% UNED theme for Beamer Gemini
% Based on the Gemini theme: https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

\definecolor{UNEDAzul}{HTML}{0D3996}
\definecolor{UNEDBlanco}{HTML}{FFFFFF}
\definecolor{UNEDAmarillo}{HTML}{FBB92A}
\definecolor{UNEDAzulOscuro}{HTML}{021135}
\definecolor{UNEDGrisClaro}{HTML}{D5D5D5}
\definecolor{UNEDNaranja}{HTML}{F95125}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=UNEDAzul,bg=UNEDBlanco}
\setbeamercolor{palette secondary}{fg=UNEDAzulOscuro,bg=UNEDBlanco}
\setbeamercolor{palette tertiary}{bg=UNEDAmarillo,fg=UNEDAzulOscuro}
\setbeamercolor{palette quaternary}{fg=UNEDNaranja,bg=UNEDGrisClaro}
\setbeamercolor{structure}{fg=UNEDAzulOscuro}

% Headline
\setbeamercolor{headline}{fg=UNEDBlanco,bg=UNEDAzul}
\setbeamercolor{headline rule}{bg=UNEDAmarillo}

% Block
\setbeamercolor{block title}{fg=UNEDAzul,bg=UNEDBlanco}
\setbeamercolor{block separator}{bg=UNEDAzul}
\setbeamercolor{block body}{fg=UNEDAzulOscuro,bg=UNEDBlanco}

% Alert Block
\setbeamercolor{block alerted title}{fg=UNEDAzulOscuro,bg=UNEDAmarillo}
\setbeamercolor{block alerted separator}{bg=UNEDAzulOscuro}
\setbeamercolor{block alerted body}{fg=UNEDAzulOscuro,bg=UNEDAmarillo}

% Example Block
\setbeamercolor{block example title}{fg=UNEDAzul,bg=UNEDGrisClaro}
\setbeamercolor{block example separator}{bg=UNEDAzul}
\setbeamercolor{block example body}{fg=UNEDAzulOscuro,bg=UNEDGrisClaro}

% Heading
\setbeamercolor{heading}{fg=UNEDAzulOscuro}

% Itemize
\setbeamercolor{item}{fg=UNEDAzulOscuro}

% Bibliography
\setbeamercolor{bibliography item}{fg=UNEDAzulOscuro}
\setbeamercolor{bibliography entry author}{fg=UNEDAzulOscuro}
\setbeamercolor{bibliography entry title}{fg=UNEDAzulOscuro}
\setbeamercolor{bibliography entry location}{fg=UNEDAzulOscuro}
\setbeamercolor{bibliography entry note}{fg=UNEDAzulOscuro}